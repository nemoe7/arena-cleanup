# Copy this file to .env and fill in the values. `docker compose` reads a .env
# file next to docker-compose.yml automatically and substitutes the values
# below, so there is nothing to export in your shell.
#
# .env is git-ignored and the Docker build context excludes it, so the key
# stays on the machine that runs the containers.

# The identity the engine rewrites commits to. A run refuses to start without
# both: an unsigned, wrongly attributed commit is worse than no rewrite.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Tailscale auth key, from the admin console under Settings -> Keys.
# Needed for the first `up` only. The tailscale-state volume keeps the node
# key afterwards, so the auth key can be revoked once the node is up.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx

# Optional: a GitHub token, so the app is signed in without `gh auth login`.
# Use a classic token with repo, read:org (and workflow if the PRs live in a
# workflow-heavy repo). It is passed to gh over stdin and stored in the
# arena-home volume.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
