# Copy this file to .env and fill in the values. `docker compose` reads it
# next to docker-compose.yml, so there is nothing to export in your shell.

# .env is git-ignored and the Docker build context excludes it. Your key
# stays on the machine that runs the containers.

# The identity the engine rewrites commits to. A run refuses to start
# without both, since a wrongly attributed commit is worse than no rewrite.
GIT_AUTHOR_NAME=Your Name
GIT_AUTHOR_EMAIL=you@example.com

# Zone of the container log stamps, an IANA name. Unset means UTC.
TZ=Asia/Manila

# Tailscale auth key, from the admin console under Settings -> Keys. The
# first `up` needs it, and the tailscale-state volume keeps the node key after.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxxxxxxxxxx

# Optional: a GitHub token, so the app is signed in without `gh auth login`.
# Use a classic token with repo, read:org, and workflow for workflow-heavy repos.

# The entrypoint feeds it to gh over stdin and keeps it in the arena-home volume.
# GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
